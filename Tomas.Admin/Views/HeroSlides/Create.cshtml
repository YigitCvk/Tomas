@model Tomas.Application.DTOs.HeroSlideFormDto
@{
    ViewData["Title"] = "Yeni Hero Slide";
}

<div class="breadcrumb">
    <a href="@Url.Action("Index","HeroSlides")">Hero Slider</a>
    <span>›</span>
    <span>Yeni Slide</span>
</div>

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary-errors"></div>

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:24px;align-items:start">
        <div>
            <div class="card">
                <div class="card-header"><h2>Slide İçeriği</h2></div>
                <div class="card-body">
                    <div class="form-group">
                        <label class="form-label">Başlık *</label>
                        <input asp-for="Title" class="form-control" required/>
                        <span asp-validation-for="Title" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Alt Başlık / Eyebrow</label>
                        <input asp-for="Subtitle" class="form-control" placeholder="Örn: Global Ticaret"/>
                        <span asp-validation-for="Subtitle" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>
                    <hr class="section-divider"/>
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Birincil Buton Metni</label>
                            <input asp-for="PrimaryButtonText" class="form-control" placeholder="Teklif Al"/>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Birincil Buton URL</label>
                            <input asp-for="PrimaryButtonUrl" class="form-control" placeholder="/iletisim"/>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">İkincil Buton Metni</label>
                            <input asp-for="SecondaryButtonText" class="form-control" placeholder="Hizmetler"/>
                        </div>
                        <div class="form-group">
                            <label class="form-label">İkincil Buton URL</label>
                            <input asp-for="SecondaryButtonUrl" class="form-control" placeholder="/hizmetler"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-header"><h2>Ayarlar</h2></div>
                <div class="card-body">
                    <div class="form-group">
                        <label class="form-label">Dil</label>
                        <select asp-for="LanguageCode" class="form-control">
                            <option value="tr">Türkçe</option>
                            <option value="en">English</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Sıralama</label>
                        <input asp-for="SortOrder" type="number" min="0" class="form-control"/>
                        <span asp-validation-for="SortOrder" class="field-validation-error"></span>
                    </div>
                    <div class="form-check form-group">
                        <input asp-for="IsActive" type="checkbox" id="isActive"/>
                        <label for="isActive" class="form-label" style="margin:0">Aktif</label>
                    </div>
                    <hr class="section-divider"/>
                    <div class="form-group">
                        <label class="form-label">Arka Plan Görseli</label>
                        <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" class="form-control"/>
                        <small style="color:#94a3b8;font-size:12px">Max 5MB, JPG/PNG/WEBP</small>
                    </div>
                    <input asp-for="ImagePath" type="hidden"/>
                </div>
            </div>
            <div style="margin-top:16px;display:flex;flex-direction:column;gap:8px">
                <button type="submit" class="btn btn-primary">💾 Kaydet</button>
                <a href="@Url.Action("Index")" class="btn btn-outline">İptal</a>
            </div>
        </div>
    </div>
</form>
