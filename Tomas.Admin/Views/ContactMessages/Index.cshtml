@using Tomas.Application.DTOs
@model List<ContactMessageDto>
@{
    ViewData["Title"] = "İletişim Mesajları";
    int page = ViewBag.Page;
    int pageSize = ViewBag.PageSize;
    int total = ViewBag.Total;
    int totalPages = (int)Math.Ceiling(total / (double)pageSize);
    bool? unreadOnly = ViewBag.UnreadOnly;
}

<div class="card">
    <div class="card-header">
        <h2>Mesajlar <span style="font-weight:400;font-size:13px;color:#64748b">(Toplam: @total)</span></h2>
        <div style="display:flex;gap:8px">
            <a href="@Url.Action("Index")" class="btn btn-outline btn-sm @(unreadOnly == null ? "btn-primary" : "")">Tümü</a>
            <a href="@Url.Action("Index", new { unreadOnly = true })" class="btn btn-outline btn-sm @(unreadOnly == true ? "btn-primary" : "")">Okunmamış</a>
            <a href="@Url.Action("ExportCsv")" class="btn btn-gold btn-sm">📥 CSV İndir</a>
        </div>
    </div>
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>#</th><th>Ad Soyad</th><th>Şirket</th><th>E-posta</th><th>Hizmet</th><th>Tarih</th><th>Durum</th><th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="@(item.IsRead ? "" : "font-weight:600")">
                        <td style="color:#94a3b8">@item.Id</td>
                        <td>
                            @if (!item.IsRead) { <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#3b82f6;margin-right:6px;"></span> }
                            @item.FullName
                        </td>
                        <td>@(item.CompanyName ?? "—")</td>
                        <td><a href="mailto:@item.Email" style="color:#0f2550">@item.Email</a></td>
                        <td style="font-size:12px">@(item.InterestedServiceTitle ?? "—")</td>
                        <td style="font-size:12px">@item.CreatedAt.ToString("dd.MM.yy HH:mm")</td>
                        <td>
                            @if (!item.IsRead) { <span class="status-badge status-unread">Yeni</span> }
                            else if (item.IsReplied) { <span class="status-badge status-active">Yanıtlandı</span> }
                            else { <span class="status-badge status-read">Okundu</span> }
                        </td>
                        <td>
                            <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-outline btn-sm">👁️ Detay</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" style="text-align:center;padding:32px;color:#94a3b8">Mesaj bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-body">
            <div class="pagination">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a href="@Url.Action("Index", new { page = i, unreadOnly })" class="page-btn @(i == page ? "active" : "")">@i</a>
                }
            </div>
        </div>
    }
</div>
