@model Tomas.Infrastructure.Services.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Grid -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon bg-blue">🔧</div>
        <div class="stat-value">@Model.TotalServices</div>
        <div class="stat-label">Toplam Hizmet</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-green">✅</div>
        <div class="stat-value">@Model.ActiveServices</div>
        <div class="stat-label">Aktif Hizmet</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-indigo">📝</div>
        <div class="stat-value">@Model.TotalBlogPosts</div>
        <div class="stat-label">Toplam Haber</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-teal">📰</div>
        <div class="stat-value">@Model.ActiveBlogPosts</div>
        <div class="stat-label">Aktif Haber</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-red">💬</div>
        <div class="stat-value">@Model.UnreadMessages</div>
        <div class="stat-label">Okunmamış Mesaj</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-orange">📩</div>
        <div class="stat-value">@Model.UnrepliedMessages</div>
        <div class="stat-label">Yanıtlanmamış Mesaj</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-amber">🎯</div>
        <div class="stat-value">@Model.ActiveHeroSlides</div>
        <div class="stat-label">Aktif Hero Slide</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-purple">❓</div>
        <div class="stat-value">@Model.TotalFaqs</div>
        <div class="stat-label">SSS Sorusu</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-pink">⭐</div>
        <div class="stat-value">@Model.TotalTestimonials</div>
        <div class="stat-label">Müşteri Yorumu</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-green">📄</div>
        <div class="stat-value">@Model.TotalPages</div>
        <div class="stat-label">Toplam Sayfa</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon bg-blue">🗂️</div>
        <div class="stat-value">@Model.TotalMedia</div>
        <div class="stat-label">Medya Dosyası</div>
    </div>
</div>

<!-- Hızlı Aksiyonlar & Son Aktivite -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">

    <!-- Hızlı Aksiyonlar -->
    <div class="card">
        <div class="card-header"><h2>⚡ Hızlı Aksiyonlar</h2></div>
        <div class="card-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                <a href="@Url.Action("Create","Services")" class="btn btn-primary" style="justify-content:center">+ Yeni Hizmet</a>
                <a href="@Url.Action("Create","BlogPosts")" class="btn btn-primary" style="justify-content:center">+ Yeni Haber</a>
                <a href="@Url.Action("Create","Faqs")" class="btn btn-outline" style="justify-content:center">+ Yeni SSS</a>
                <a href="@Url.Action("Create","HeroSlides")" class="btn btn-outline" style="justify-content:center">+ Hero Slide</a>
                <a href="@Url.Action("Index","MediaAssets")" class="btn btn-outline" style="justify-content:center">🗂️ Medya Yükle</a>
                <a href="@Url.Action("Index","SiteSettings")" class="btn btn-outline" style="justify-content:center">⚙️ Site Ayarları</a>
                <a href="@Url.Action("Index","ContactMessages")" class="btn btn-outline" style="justify-content:center">💬 Mesajlar</a>
                <a href="@Url.Action("ExportCsv","ContactMessages")" class="btn btn-outline" style="justify-content:center">📥 CSV Export</a>
            </div>
        </div>
    </div>

    <!-- Son Mesajlar -->
    <div class="card">
        <div class="card-header">
            <h2>📬 Son Mesajlar</h2>
            <a href="@Url.Action("Index","ContactMessages")" class="btn btn-outline btn-sm">Tümü</a>
        </div>
        @if (Model.RecentMessages.Any())
        {
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>Gönderen</th><th>Tarih</th><th>Durum</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model.RecentMessages)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Details","ContactMessages", new { id = msg.Id })" style="color:var(--navy);font-weight:500">@msg.FullName</a>
                                    <div style="font-size:11px;color:#94a3b8">@msg.Email</div>
                                </td>
                                <td style="font-size:12px;color:#94a3b8">@msg.CreatedAt.ToString("dd.MM.yy HH:mm")</td>
                                <td>
                                    @if (!msg.IsRead)
                                    {
                                        <span class="status-badge status-unread">● Yeni</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-read">Okundu</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body" style="text-align:center;color:#94a3b8;padding:32px">Henüz mesaj yok.</div>
        }
    </div>
</div>

<!-- Son Haberler -->
<div class="card">
    <div class="card-header">
        <h2>📰 Son Haberler</h2>
        <a href="@Url.Action("Index","BlogPosts")" class="btn btn-outline btn-sm">Tümü</a>
    </div>
    @if (Model.RecentPosts.Any())
    {
        <div class="table-responsive">
            <table>
                <thead>
                    <tr><th>#</th><th>Başlık</th><th>Tarih</th><th>Durum</th><th>İşlem</th></tr>
                </thead>
                <tbody>
                    @foreach (var post in Model.RecentPosts)
                    {
                        <tr>
                            <td style="color:#94a3b8">@post.Id</td>
                            <td style="font-weight:500">@post.Title</td>
                            <td style="font-size:12px;color:#94a3b8">@post.CreatedAt.ToString("dd.MM.yy")</td>
                            <td>
                                @if (post.IsActive)
                                {
                                    <span class="status-badge status-active">● Aktif</span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">● Pasif</span>
                                }
                            </td>
                            <td><a href="@Url.Action("Edit","BlogPosts", new { id = post.Id })" class="btn btn-outline btn-sm">✏️ Düzenle</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body" style="text-align:center;color:#94a3b8;padding:32px">Henüz haber eklenmemiş.</div>
    }
</div>
